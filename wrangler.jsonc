{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2025-05-01",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // D1 Database - 칼럼 게시판 데이터 저장
  // 로컬 개발: --local 플래그로 자동 로컬 SQLite 생성 (database_id 불필요)
  // 운영 배포 시: npx wrangler d1 create webapp-production 후 실제 ID로 교체
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "local-dev-placeholder"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // }
}